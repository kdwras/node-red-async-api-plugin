{
  "name": "node-red-custom-node",
  "version": "1.0.0",
  "description": "A custom Node-RED node",

  "dependencies": {
    "@asyncapi/parser": "^2.1.0",
    "ajv": "^8.12.0",
    "express": "^4.21.2",
    "node-red": "*",
    "mqtt": "^4.3.7",
    "node-red-dashboard": "^3.5.0",
    "node-red-node-ui-table": "^0.3.5",
    "node-red-contrib-mqtt-broker": "^0.2.9"
  },

  "devDependencies": {
    "esbuild": "^0.20.0"
  },

  "scripts": {
    "build:editor": "./node_modules/.bin/esbuild editor/src/editor-main.js --bundle --outfile=editor/dist/editor.bundle.js --format=iife",
    "watch:editor": "./node_modules/.bin/esbuild editor/src/editor-main.js --bundle --outfile=editor/dist/editor.bundle.js --format=iife --watch",
    "build:editor:min": "./node_modules/.bin/esbuild editor/src/editor-main.js --bundle --minify --outfile=editor/dist/editor.bundle.js --format=iife",
    "build:editor:debug": "./node_modules/.bin/esbuild editor/src/editor-main.js --bundle --outfile=editor/dist/editor.bundle.js --format=iife --sourcemap"
  },

  "node-red": {
    "nodes": {
      "async-api-node": "async-api-red.js"
    }
  }
}